# Optional in development. When omitted, Control uses safe local defaults.
# Production requires this path.
TALI_CONFIG=control.toml
# Worker only: copy worker.example.toml and set this path for dev:worker.
# TALI_WORKER_CONFIG=worker.toml

# Optional Runner JSON file (required in production).
# TALI_RUNNER_CONFIG=/absolute/path/to/runner.json
# Seeds missing Skills, MCP servers, Knowledge sources, and Agent Roles into PostgreSQL.
# Existing database records are preserved. Set to none when deployment-managed seeds are no longer desired.
TALI_EXTENSION_CATALOG_SEED=development

# Workspace management uses a local browser-backed mock until the backend API is available.
# Set to true when /api/workspaces and its member endpoints are deployed.
VITE_WORKSPACE_API_ENABLED=false

# Optional. Use {traceId} as the placeholder for a Grafana/Tempo trace URL.
# Example: https://grafana.example.com/explore?...{traceId}
VITE_TEMPO_TRACE_URL_TEMPLATE=

# Optional PDF OCR credential. Text-based PDFs are extracted locally and do
# not need this key. NVIDIA_API_KEY is canonical; NVAPI_API_KEY is accepted as
# a compatibility alias. A Project-visible NVIDIA embedding model reuses its
# stored Provider credential automatically.
NVIDIA_API_KEY=
# NVIDIA_OCR_ENDPOINT=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2

{
  "name": "@tali/control",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:seed-skills": "node prisma/seed-built-in-skills.mjs",
    "validate:migrations": "node ../../scripts/validate-prisma-migrations.mjs",
    "prebuild": "npm run db:generate && npm run validate:migrations",
    "build": "vite build && vite build --config vite.worker.config.ts && vite build --config vite.runtime-reconcile.config.ts && vite build --config vite.runtime-bridge.config.ts",
    "dev": "node --env-file-if-exists=../../.env ../../node_modules/vite/bin/vite.js --host 0.0.0.0 --port ${PORT:-8080}",
    "start": "node .output/server/index.mjs",
    "start:control-worker": "node .output/workers/control-worker.mjs",
    "start:project-runtime-bridge": "node .output/runtime-bridge/project-runtime-bridge.mjs",
    "reconcile:project-runtime": "node .output/tools/project-runtime-reconcile.mjs",
    "pretest": "npm run db:generate && npm run validate:migrations",
    "test": "vitest run --config vitest.config.ts",
    "pretypecheck": "npm run db:generate && npm run validate:migrations",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@blobatar/react": "^2.2.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-tc": "^5.3.0",
    "@fontsource/chivo-mono": "^5.2.8",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@kubernetes/client-node": "1.4.0",
    "@melloware/react-logviewer": "6.3.3",
    "@nivo/bar": "^0.99.0",
    "@nivo/calendar": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tali/contracts": "0.1.0",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.28",
    "@tanstack/react-table": "^8.21.3",
    "@vectorize-io/hindsight-client": "^0.9.2",
    "better-auth": "^1.7.1",
    "blobatar": "^2.2.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ghostty-web": "0.4.0-next.20.g1858a59",
    "i18next": "^26.4.0",
    "lucide-react": "^1.24.0",
    "nitro": "3.0.260610-beta",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pg-boss": "^12.27.0",
    "prisma": "^7.9.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.13.0",
    "simple-icons": "^16.27.0",
    "smol-toml": "^1.7.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "ws": "^8.21.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}

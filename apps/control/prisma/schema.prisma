generator client {
  provider   = "prisma-client"
  output     = "../server/generated/prisma"
  engineType = "client"
  runtime    = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["tasklattice"]
}

enum ProjectRole {
  admin
  auditor
  developer
  user
  reviewer

  @@map("project_role")
  @@schema("tasklattice")
}

enum DepartmentRole {
  administrator
  member

  @@map("department_role")
  @@schema("tasklattice")
}

enum SystemRole {
  user
  platform_administrator

  @@map("system_role")
  @@schema("tasklattice")
}

enum AccessContextLevel {
  PLATFORM
  DEPARTMENT
  PROJECT

  @@map("access_context_level")
  @@schema("tasklattice")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
  @@schema("tasklattice")
}

enum ExternalIdentitySubjectType {
  GROUP
  CLIENT

  @@map("external_identity_subject_type")
  @@schema("tasklattice")
}

enum ExternalRoleScope {
  PLATFORM
  DEPARTMENT
  PROJECT

  @@map("external_role_scope")
  @@schema("tasklattice")
}

enum AuthorizationScope {
  PLATFORM
  DEPARTMENT
  PROJECT

  @@map("authorization_scope")
  @@schema("tasklattice")
}

enum AuthorizationRoleFamily {
  ADMINISTRATION
  PROJECT_BUSINESS

  @@map("authorization_role_family")
  @@schema("tasklattice")
}

enum McpDiscoveryStatus {
  HEALTHY
  PERMISSION_REQUIRED
  UNCHECKED
  UNAVAILABLE

  @@map("mcp_discovery_status")
  @@schema("tasklattice")
}

enum MemoryStatus {
  provisioning
  ready
  degraded
  unbound
  deleting
  deletion_failed
  deleted

  @@map("memory_status")
  @@schema("tasklattice")
}

enum MemoryBindingStatus {
  pending
  active
  detached

  @@map("memory_binding_status")
  @@schema("tasklattice")
}

enum MemoryRuntimeType {
  openclaw
  hermes

  @@map("memory_runtime_type")
  @@schema("tasklattice")
}

enum MemoryBindingKind {
  primary

  @@map("memory_binding_kind")
  @@schema("tasklattice")
}

enum MemoryOutboxStatus {
  pending
  processing
  retry
  delivered
  dead_letter

  @@map("memory_outbox_status")
  @@schema("tasklattice")
}

enum MemoryExperienceStatus {
  active
  invalidated

  @@map("memory_experience_status")
  @@schema("tasklattice")
}

enum ExpertAgentRelation {
  OWNER
  MAINTAINER

  @@map("expert_agent_relation")
  @@schema("tasklattice")
}

enum ExpertAgentExecutionMode {
  AGENTIC
  WORKFLOW

  @@map("expert_agent_execution_mode")
  @@schema("tasklattice")
}

model User {
  id                            String     @id
  username                      String?    @unique
  email                         String     @unique
  emailVerified                 Boolean    @default(false) @map("email_verified")
  displayName                   String     @map("display_name")
  image                         String?
  language                      String     @default("en-US")
  timezone                      String     @default("UTC")
  theme                         String     @default("system")
  systemRole                    SystemRole @default(user) @map("system_role")
  externalPlatformAdministrator Boolean    @default(false) @map("external_platform_administrator")
  status                        UserStatus @default(active)
  createdAt                     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdProjects       Project[]           @relation("ProjectCreator")
  createdDepartments    Department[]        @relation("DepartmentCreator")
  departmentMemberships DepartmentMember[]
  authAccounts          AuthAccount[]
  authSessions          AuthSession[]
  memberships           ProjectMember[]
  notifications         UserNotification[]
  invitations           ProjectInvitation[] @relation("InvitationCreator")
  externalRoleGrants    ExternalRoleGrant[]

  @@map("users")
  @@schema("tasklattice")
}

model PlatformSettingsRecord {
  id                                     String   @id @default("platform")
  controlInternalUrl                     String?  @map("control_internal_url")
  runnerUrl                              String?  @map("runner_url")
  runnerTokenEncrypted                   String?  @map("runner_token_encrypted")
  litellmUrl                             String?  @map("litellm_url")
  litellmMasterKeyEncrypted              String?  @map("litellm_master_key_encrypted")
  runtimeNamespacesEnabled               Boolean? @map("runtime_namespaces_enabled")
  runtimeClusterId                       String?  @map("runtime_cluster_id")
  localAuthenticationEnabled             Boolean? @map("local_authentication_enabled")
  runtimeImages                          Json?    @map("runtime_images")
  sandboxCpu                             String?  @map("sandbox_cpu")
  sandboxMemory                          String?  @map("sandbox_memory")
  enabledProviderKinds                   Json?    @map("enabled_provider_kinds")
  oidcEnabled                            Boolean  @default(false) @map("oidc_enabled")
  oidcDisplayName                        String   @default("SSO") @map("oidc_display_name")
  oidcIssuer                             String   @default("") @map("oidc_issuer")
  oidcClientId                           String   @default("") @map("oidc_client_id")
  oidcGroupClaim                         String   @default("groups") @map("oidc_group_claim")
  oidcClientSecretEncrypted              String?  @map("oidc_client_secret_encrypted")
  smtpEnabled                            Boolean  @default(false) @map("smtp_enabled")
  smtpHost                               String   @default("") @map("smtp_host")
  smtpPort                               Int      @default(587) @map("smtp_port")
  smtpSecure                             Boolean  @default(false) @map("smtp_secure")
  smtpUsername                           String   @default("") @map("smtp_username")
  smtpPasswordEncrypted                  String?  @map("smtp_password_encrypted")
  smtpFromAddress                        String   @default("") @map("smtp_from_address")
  smtpFromName                           String   @default("TaskLattice Relay") @map("smtp_from_name")
  smtpReplyTo                            String   @default("") @map("smtp_reply_to")
  runtimeNamespaceDeletionTimeoutSeconds Int      @default(120) @map("runtime_namespace_deletion_timeout_seconds")
  revision                               Int      @default(1)
  updatedBy                              String?  @map("updated_by")
  createdAt                              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
  @@schema("tasklattice")
}

model ExternalRoleBinding {
  id           String                      @id @default(uuid())
  providerId   String                      @default("corporate-sso") @map("provider_id")
  subjectType  ExternalIdentitySubjectType @default(GROUP) @map("subject_type")
  subjectValue String                      @map("subject_value")
  scope        ExternalRoleScope
  departmentId String?                     @map("department_id")
  projectId    String?                     @map("project_id")
  roleId       String                      @map("role_id")
  enabled      Boolean                     @default(true)
  createdBy    String?                     @map("created_by")
  createdAt    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department?         @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project    Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  grants     ExternalRoleGrant[]

  @@index([providerId, subjectType, subjectValue, enabled])
  @@index([scope, departmentId, projectId, roleId])
  @@map("external_role_bindings")
  @@schema("tasklattice")
}

model ExternalRoleGrant {
  bindingId  String   @map("binding_id")
  userId     String   @map("user_id")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  binding ExternalRoleBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([bindingId, userId])
  @@index([userId, lastSeenAt])
  @@map("external_role_grants")
  @@schema("tasklattice")
}

model RoleCatalogState {
  id       String   @id @default("builtin")
  revision Int
  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@map("role_catalog_state")
  @@schema("tasklattice")
}

model CapabilityDefinition {
  id               String             @id
  scope            AuthorizationScope
  sideEffect       Boolean            @default(false) @map("side_effect")
  sensitiveContent Boolean            @default(false) @map("sensitive_content")
  systemManaged    Boolean            @default(true) @map("system_managed")
  sortOrder        Int                @default(0) @map("sort_order")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roleGrants RoleCapabilityGrant[]

  @@index([scope, sortOrder])
  @@map("capability_definitions")
  @@schema("tasklattice")
}

model RoleDefinition {
  id            String                  @id
  scope         AuthorizationScope
  family        AuthorizationRoleFamily
  name          String
  description   String
  builtin       Boolean                 @default(true)
  assignable    Boolean                 @default(true)
  systemManaged Boolean                 @default(true) @map("system_managed")
  sortOrder     Int                     @default(0) @map("sort_order")
  revision      Int                     @default(1)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  grants RoleCapabilityGrant[]

  @@index([family, sortOrder])
  @@index([scope, sortOrder])
  @@map("role_definitions")
  @@schema("tasklattice")
}

model RoleCapabilityGrant {
  roleId       String @map("role_id")
  capabilityId String @map("capability_id")
  relations    Json

  role       RoleDefinition       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  capability CapabilityDefinition @relation(fields: [capabilityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, capabilityId])
  @@index([capabilityId])
  @@map("role_capability_grants")
  @@schema("tasklattice")
}

model Department {
  id                                         String   @id
  name                                       String   @unique
  description                                String?
  defaultChatModel                           String?  @map("default_chat_model")
  defaultEmbeddingModel                      String?  @map("default_embedding_model")
  defaultRoutingMode                         String   @default("PROJECT_MANAGED") @map("default_routing_mode")
  defaultFallbackModel                       String?  @map("default_fallback_model")
  softBudgetUsd                              Decimal? @map("soft_budget_usd") @db.Decimal(18, 6)
  hardBudgetUsd                              Decimal? @map("hard_budget_usd") @db.Decimal(18, 6)
  softMaxInstances                           Int?     @map("soft_max_instances")
  hardMaxInstances                           Int?     @map("hard_max_instances")
  softMaxMcpIntegrations                     Int?     @map("soft_max_mcp_integrations")
  hardMaxMcpIntegrations                     Int?     @map("hard_max_mcp_integrations")
  softMaxKnowledgeBaseIntegrations           Int?     @map("soft_max_knowledge_base_integrations")
  hardMaxKnowledgeBaseIntegrations           Int?     @map("hard_max_knowledge_base_integrations")
  defaultProjectHardBudgetUsd                Decimal? @map("default_project_hard_budget_usd") @db.Decimal(18, 6)
  defaultProjectBudgetDuration               String?  @map("default_project_budget_duration")
  defaultProjectTpmLimit                     BigInt?  @map("default_project_tpm_limit")
  defaultProjectMaxInstances                 Int?     @map("default_project_max_instances")
  defaultProjectMaxMcpIntegrations           Int?     @map("default_project_max_mcp_integrations")
  defaultProjectMaxKnowledgeBaseIntegrations Int?     @map("default_project_max_knowledge_base_integrations")
  settingsRevision                           Int      @default(1) @map("settings_revision")
  status                                     String   @default("active")
  createdBy                                  String   @map("created_by")
  createdAt                                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator              User                                @relation("DepartmentCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  members              DepartmentMember[]
  projects             Project[]
  inferenceResources   DepartmentInferenceResourceRecord[]
  modelRoutingAudit    DepartmentModelRoutingAuditRecord[]
  externalRoleBindings ExternalRoleBinding[]

  @@map("departments")
  @@schema("tasklattice")
}

model DepartmentMember {
  departmentId         String         @map("department_id")
  userId               String         @map("user_id")
  role                 DepartmentRole @default(member)
  status               String         @default("active")
  manualAccess         Boolean        @default(true) @map("manual_access")
  externalAccessActive Boolean        @default(false) @map("external_access_active")
  joinedAt             DateTime       @default(now()) @map("joined_at") @db.Timestamptz(6)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([departmentId, userId])
  @@index([userId, role, status])
  @@map("department_members")
  @@schema("tasklattice")
}

model UserNotification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  title      String
  message    String
  severity   String    @default("info")
  actionHref String?   @map("action_href")
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("user_notifications")
  @@schema("tasklattice")
}

model AuthSession {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accessContext AccessContextSession?

  @@index([userId])
  @@map("auth_sessions")
  @@schema("tasklattice")
}

model AccessContextSession {
  sessionId  String             @id @map("session_id")
  level      AccessContextLevel
  resourceId String?            @map("resource_id")
  roleId     String             @map("role_id")
  selectedAt DateTime           @default(now()) @map("selected_at") @db.Timestamptz(6)
  updatedAt  DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([level, resourceId])
  @@map("access_context_sessions")
  @@schema("tasklattice")
}

model AuthAccount {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  issuer                String
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("auth_accounts")
  @@schema("tasklattice")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verifications")
  @@schema("tasklattice")
}

model Project {
  id                                  String    @id
  name                                String
  avatar                              String?
  departmentId                        String    @map("department_id")
  createdBy                           String    @map("created_by")
  createdAt                           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                           DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy                           String?   @map("deleted_by")
  inheritedDepartmentDefaults         Json?     @map("inherited_department_defaults")
  inheritedDepartmentSettingsRevision Int?      @map("inherited_department_settings_revision")

  department                   Department                               @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator                      User                                     @relation("ProjectCreator", fields: [createdBy], references: [id])
  humanMembers                 ProjectMember[]
  invitations                  ProjectInvitation[]
  agents                       AgentRecord[]
  agentCatalogEntries          AgentCatalogRecord[]
  providerAccounts             ProviderAccountRecord[]
  modelDeployments             ModelDeploymentRecord[]
  inferenceGateways            InferenceGatewayRecord[]
  modelRoutings                ModelRoutingRecord[]
  modelRoutingBindings         ModelRoutingBindingRecord[]
  modelRoutingAudit            ModelRoutingAuditRecord[]
  inheritedDepartmentModels    ProjectDepartmentModelBinding[]
  inheritedDepartmentRoutings  ProjectDepartmentRoutingBinding[]
  sandboxPolicies              SandboxPolicyRecord[]
  accessPolicies               AccessPolicyRecord[]
  accessPolicyVersions         AccessPolicyVersionRecord[]
  instanceAccessPolicyBindings AgentInstanceAccessPolicyBindingRecord[]
  skills                       SkillRecord[]
  mcpServers                   McpServerRecord[]
  knowledgeSources             KnowledgeSourceRecord[]
  knowledgeVectorDatabases     KnowledgeVectorDatabase[]
  vectorDocuments              VectorDocument[]
  vectorIngestionJobs          VectorIngestionJob[]
  specializations              AgentSpecializationRecord[]
  costAttributions             CostAttributionMappingRecord[]
  modelEndpointMaps            ModelEndpointMappingRecord[]
  usageFacts                   ModelUsageFactRecord[]
  usageObservations            ModelUsageFactObservation[]
  usageDaily                   ModelUsageDailyRecord[]
  costSyncCheckpoints          CostSyncCheckpointRecord[]
  runs                         ProjectRunRecord[]
  auditLogs                    AuditLogRecord[]
  quota                        ProjectQuotaRecord?
  deletionTask                 ProjectDeletionTask?
  runtimeTarget                ProjectRuntimeTarget?
  externalRoleBindings         ExternalRoleBinding[]
  memories                     MemoryRecord[]
  instanceLifecycleOperations  InstanceLifecycleOperation[]
  instanceLifecycleEvents      InstanceLifecycleEvent[]
  expertAgents                 ExpertAgentRecord[]

  @@unique([departmentId, name], map: "projects_department_name_key")
  @@index([departmentId, createdAt])
  @@map("projects")
  @@schema("tasklattice")
}

model ProjectRuntimeTarget {
  projectId          String    @id @map("project_id")
  clusterId          String    @map("cluster_id")
  namespace          String    @unique(map: "project_runtime_targets_namespace_key")
  status             String    @default("pending")
  generation         Int       @default(1)
  observedGeneration Int       @default(0) @map("observed_generation")
  nextAttemptAt      DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner         String?   @map("lease_owner")
  leaseExpiresAt     DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  attempts           Int       @default(0)
  lastError          String?   @map("last_error")
  lastReconciledAt   DateTime? @map("last_reconciled_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt], map: "project_runtime_targets_due_idx")
  @@index([leaseExpiresAt], map: "project_runtime_targets_lease_idx")
  @@map("project_runtime_targets")
  @@schema("tasklattice")
}

model ProjectDeletionTask {
  projectId      String    @id @map("project_id")
  queueJobId     String?   @map("queue_job_id") @db.Uuid
  status         String    @default("scheduled")
  scheduledFor   DateTime  @map("scheduled_for") @db.Timestamptz(6)
  nextAttemptAt  DateTime  @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([queueJobId], map: "project_deletion_tasks_queue_job_id_key")
  @@index([status, nextAttemptAt, scheduledFor], map: "project_deletion_tasks_due_idx")
  @@index([leaseExpiresAt], map: "project_deletion_tasks_lease_idx")
  @@map("project_deletion_tasks")
  @@schema("tasklattice")
}

model ProjectQuotaRecord {
  projectId                    String    @id @map("project_id")
  hardBudgetUsd                Decimal?  @map("hard_budget_usd") @db.Decimal(18, 6)
  budgetDuration               String?   @map("budget_duration")
  budgetPeriodStartedAt        DateTime? @map("budget_period_started_at") @db.Timestamptz(6)
  budgetResetsAt               DateTime? @map("budget_resets_at") @db.Timestamptz(6)
  tpmLimit                     BigInt?   @map("tpm_limit")
  maxInstances                 Int?      @map("max_instances")
  maxMcpIntegrations           Int?      @map("max_mcp_integrations")
  maxKnowledgeBaseIntegrations Int?      @map("max_knowledge_base_integrations")
  litellmTeamId                String?   @map("litellm_team_id")
  syncStatus                   String    @default("pending") @map("sync_status")
  lastSyncedAt                 DateTime? @map("last_synced_at") @db.Timestamptz(6)
  lastSyncError                String?   @map("last_sync_error")
  updatedBy                    String?   @map("updated_by")
  revision                     Int       @default(1)
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_quotas")
  @@schema("tasklattice")
}

model ProjectRunRecord {
  projectId      String    @map("project_id")
  id             String
  instanceId     String    @map("instance_id")
  agentPlatform  String    @map("agent_platform")
  source         String
  externalRunId  String    @map("external_run_id")
  triggerType    String    @map("trigger_type")
  status         String
  traceId        String?   @map("trace_id")
  startedAt      DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)
  durationMs     Int?      @map("duration_ms")
  terminalReason String?   @map("terminal_reason")
  errorCategory  String?   @map("error_category")
  expertAgentId  String?   @map("expert_agent_id") @db.Uuid
  expertAgentVersionId String? @map("expert_agent_version_id") @db.Uuid
  expertEngineVersion String? @map("expert_engine_version")
  expertTrace     Json?     @map("expert_trace")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@unique([projectId, instanceId, source, externalRunId], map: "project_runs_runtime_id_key")
  @@index([projectId, startedAt], map: "project_runs_project_started_idx")
  @@index([projectId, status, startedAt], map: "project_runs_project_status_started_idx")
  @@index([projectId, instanceId, startedAt], map: "project_runs_project_instance_started_idx")
  @@index([projectId, expertAgentId, expertAgentVersionId, startedAt(sort: Desc)], map: "project_runs_expert_agent_version_started_idx")
  @@map("project_runs")
